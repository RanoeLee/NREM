# Manuscript materials are confidential local working files. The public code
# release contains machine-readable result summaries, not the paper source.
/paper/
/pull_paper_from_gitee.cmd
/scripts/sync_paper_from_gitee.ps1

# Local research ledgers remain available in the working copy but are not part
# of the public GitHub surface. Only the finished public documentation is kept.
/docs/*
!/docs/README.md
!/docs/DATA.md
!/docs/REPRODUCIBILITY.md
!/docs/RESULTS.md
!/docs/COMPLEXITY.md

# Curated, path-free paper tables only.
/results/*
!/results/paper_400_600_run_level.csv
!/results/paper_400_600_summary.csv
!/results/complexity_profile.csv
!/results/complexity_profile.json
!/results/aggregate_efficiency.csv

# Internal-only post-hoc analysis and batch orchestration helpers. These files
# reference private servers, transient experiment revisions, or scheduler
# workflows and are not needed to verify the published EXP_RESULTS bundle.
/tools/analyze_low_fpr_metrics.py
/tools/analyze_composition_robustness.py
/tools/build_composition_robustness_manifest.py
/tools/build_composition_robustness_sets.py
/tools/submit_composition_robustness.py
/tests/test_analyze_low_fpr_metrics.py
/tests/test_analyze_composition_robustness.py
/tests/test_build_composition_robustness_manifest.py
/tests/test_build_composition_robustness_sets.py
/tests/test_composition_robustness_sbatch.py
/tests/test_submit_composition_robustness.py
/configs/external/*retry*.yaml
/scripts/slurm/run_composition_robustness_task.sbatch
